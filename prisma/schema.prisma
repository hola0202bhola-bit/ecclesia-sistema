generator client {
  provider = "prisma-client-js"
}

model ImportacionLocalidades {
  id String @id @default(uuid()) @db.Uuid
  estadoClave String @db.VarChar(2)
  municipioClave String @db.VarChar(3)
  municipio Municipio @relation(fields: [estadoClave, municipioClave], references: [estadoClave, codigo], onDelete: Restrict)
  origen String
  estado String @default("PREVIA")
  actorId String @db.Uuid
  autor Usuario @relation("ImportacionAutor", fields: [actorId], references: [id], onDelete: Restrict)
  aplicadoPor String? @db.Uuid
  aplicador Usuario? @relation("ImportacionAplicador", fields: [aplicadoPor], references: [id], onDelete: Restrict)
  revertidaPor String? @db.Uuid
  reversor Usuario? @relation("ImportacionReversor", fields: [revertidaPor], references: [id], onDelete: Restrict)
  fuente String
  consulta String
  sha256 String @db.VarChar(64)
  original String
  antes Json
  diferencias Json
  huellaAntes String @db.VarChar(64)
  huellaDespues String? @db.VarChar(64)
  revision Int?
  creadoEn DateTime @default(now()) @db.Timestamptz(3)
  aplicadaEn DateTime? @db.Timestamptz(3)
  revertidaEn DateTime? @db.Timestamptz(3)
  motivo String? @db.VarChar(500)
  motivoReversion String? @db.VarChar(500)
  @@unique([estadoClave, municipioClave, revision])
  @@index([actorId])
  @@index([aplicadoPor])
  @@index([revertidaPor])
}

datasource db {
  provider = "postgresql"
}

// Identifica una carga completa; nunca habilita reemplazar registros del usuario.
model CargaDemo {
  id         String   @id
  referencia DateTime @db.Timestamptz(3)
  fuentes    String   @db.VarChar(64)
}

model Estado {
  clave      String      @id @db.VarChar(2)
  nombre     String
  municipios Municipio[]
}

model Municipio {
  clave       String @id @db.VarChar(5)
  estadoClave String @db.VarChar(2)
  codigo      String @db.VarChar(3)
  nombre      String
  estado      Estado @relation(fields: [estadoClave], references: [clave], onDelete: Restrict)
  localidades Localidad[]
  importaciones ImportacionLocalidades[]

  @@unique([estadoClave, codigo])
}

model CatalogoVersion {
  version  String @id
  consulta String
  sha256   String @db.VarChar(64)
  manifest Json
}

model Localidad {
  clave          String    @id @db.VarChar(9)
  estadoClave    String    @db.VarChar(2)
  municipioClave String    @db.VarChar(3)
  localidadClave String    @db.VarChar(4)
  nombre         String
  fuente         String
  consulta       String
  iglesias       Iglesia[]
  municipio      Municipio @relation(fields: [estadoClave, municipioClave], references: [estadoClave, codigo], onDelete: Restrict)

  @@unique([estadoClave, municipioClave, localidadClave])
}

model TipoIglesia {
  id       String    @id @db.Uuid
  nombre   String    @unique
  iglesias Iglesia[]
}

model Iglesia {
  id               String                @id @default(uuid()) @db.Uuid
  nombre           String                @db.VarChar(200)
  nombreBusqueda   String                @db.VarChar(200)
  tipoId           String                @db.Uuid
  tipo             TipoIglesia           @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  estadoClave      String                @db.VarChar(2)
  municipioClave   String                @db.VarChar(3)
  localidadClave   String                @db.VarChar(4)
  localidad        Localidad             @relation(fields: [estadoClave, municipioClave, localidadClave], references: [estadoClave, municipioClave, localidadClave], onDelete: Restrict)
  direccion        String                @db.VarChar(500)
  capacidad        Int?
  anioConstruccion Int?
  contacto         String?               @db.VarChar(300)
  latitud          Float?
  longitud         Float?
  zonaIana         String?               @db.VarChar(100)
  cerradaDesde     DateTime?
  version          Int                   @default(1)
  usuarios         Usuario[]
  objetos          ObjetoPatrimonial[]
  servicios        ServicioOfrecido[]
  platicas         Platica[]
  sacerdotes       AsignacionSacerdote[]
  horariosMisa     HorarioMisa[]
  ocurrenciasMisa  OcurrenciaMisa[]
  celebraciones    CelebracionMisa[]
  diezmos          Diezmo[]
  espacios         OfertaFuneraria[]
  solicitudes      SolicitudEspacio[]
  cambiosCierre CambioCierre[]

  @@index([estadoClave, municipioClave, localidadClave])
}

enum RolPersonal {
  COORDINACION
  ADMIN_IGLESIA
  TESORERO
}

model Usuario {
  id                 String             @id @default(uuid()) @db.Uuid
  identificador      String             @unique @db.VarChar(80)
  passwordHash       String             @db.VarChar(60)
  rol                RolPersonal
  iglesiaId          String?            @db.Uuid
  iglesia            Iglesia?           @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  activo             Boolean            @default(true)
  importacionesPrevias ImportacionLocalidades[] @relation("ImportacionAutor")
  importacionesAplicadas ImportacionLocalidades[] @relation("ImportacionAplicador")
  importacionesRevertidas ImportacionLocalidades[] @relation("ImportacionReversor")
  sesiones           Sesion[]
  cambiosPatrimonio  CambioPatrimonio[]
  cambiosCierre CambioCierre[]
  cambiosCriterio CambioCriterio[]
  cambiosOferta      CambioOferta[]
  cambiosAgenda      CambioAgenda[]
  correccionesDiezmo CorreccionDiezmo[]
  cambiosSolicitud   CambioSolicitud[]
  cambiosEspacio     CambioEspacio[]
  celebraciones      CelebracionMisa[]
}

enum CondicionPatrimonio {
  VIGENTE
  PERDIDO
  PRESTADO
  BAJA
}

model TipoObjeto {
  id      String              @id @db.Uuid
  nombre  String              @unique
  objetos ObjetoPatrimonial[]
}

model CriterioPatrimonio {
  id         String @id
  parametros Json
  nombre String @default("Criterios del caso original") @db.VarChar(120)
  creadoEn DateTime @default(now()) @db.Timestamptz(3)
  configuraciones ConfiguracionIndice[]
  cambios CambioCriterio[] @relation("CriterioDestino")
  anteriores CambioCriterio[] @relation("CriterioAnterior")
}

model ObjetoPatrimonial {
  id               String              @id @default(uuid()) @db.Uuid
  iglesiaId        String              @db.Uuid
  iglesia          Iglesia             @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  descripcion      String              @db.VarChar(300)
  tipoId           String              @db.Uuid
  tipo             TipoObjeto          @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  anioExacto       Int?
  siglo            Int?
  material         String              @db.VarChar(200)
  conservacion     String              @db.VarChar(300)
  ubicacionInterna String              @db.VarChar(300)
  catalogadoInah   Boolean
  condicion        CondicionPatrimonio @default(VIGENTE)
  version          Int                 @default(1)
  cambios          CambioPatrimonio[]

  @@index([iglesiaId, condicion])
}

model CambioPatrimonio {
  id       String            @id @default(uuid()) @db.Uuid
  objetoId String            @db.Uuid
  objeto   ObjetoPatrimonial @relation(fields: [objetoId], references: [id], onDelete: Restrict)
  actorId  String            @db.Uuid
  actor    Usuario           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fecha    DateTime          @default(now())
  antes    Json
  despues  Json

  @@index([objetoId, fecha])
}

model Sesion {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  csrf      String   @db.VarChar(64)
  vence     DateTime

  @@index([usuarioId])
  @@index([vence])
}

model TipoServicio {
  id        String             @id @db.Uuid
  nombre    String             @unique
  servicios ServicioOfrecido[]
}

model TipoPlatica {
  id       String    @id @db.Uuid
  nombre   String    @unique
  platicas Platica[]
}

enum ModalidadAportacion {
  FIJO
  GRATUITO
  DONATIVO
}

model ServicioOfrecido {
  id              String              @id @default(uuid()) @db.Uuid
  iglesiaId       String              @db.Uuid
  iglesia         Iglesia             @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  tipoId          String              @db.Uuid
  tipo            TipoServicio        @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  nombre          String              @db.VarChar(200)
  modalidad       ModalidadAportacion
  importe         Decimal?            @db.Decimal(11, 2)
  moneda          String              @db.VarChar(3)
  requisitos      String              @db.VarChar(2000)
  duracionMinutos Int
  requiereCita    Boolean
  version         Int                 @default(1)
  horarios        HorarioServicio[]
  cambios         CambioOferta[]

  @@index([iglesiaId, id])
}

model HorarioServicio {
  servicioId String           @db.Uuid
  servicio   ServicioOfrecido @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  diaSemana  Int
  horaLocal  String           @db.VarChar(5)

  @@id([servicioId, diaSemana, horaLocal])
}

model Platica {
  id         String           @id @default(uuid()) @db.Uuid
  iglesiaId  String           @db.Uuid
  iglesia    Iglesia          @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  tipoId     String           @db.Uuid
  tipo       TipoPlatica      @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  sesiones   Int
  importe    Decimal          @db.Decimal(11, 2)
  moneda     String           @db.VarChar(3)
  cupo       Int
  lugar      String           @db.VarChar(300)
  impartidor String           @db.VarChar(200)
  version    Int              @default(1)
  horarios   HorarioPlatica[]
  cambios    CambioOferta[]

  @@index([iglesiaId, id])
}

model HorarioPlatica {
  platicaId String  @db.Uuid
  platica   Platica @relation(fields: [platicaId], references: [id], onDelete: Cascade)
  diaSemana Int
  horaLocal String  @db.VarChar(5)

  @@id([platicaId, diaSemana, horaLocal])
}

model CambioOferta {
  id         String            @id @default(uuid()) @db.Uuid
  servicioId String?           @db.Uuid
  servicio   ServicioOfrecido? @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  platicaId  String?           @db.Uuid
  platica    Platica?          @relation(fields: [platicaId], references: [id], onDelete: Restrict)
  actorId    String            @db.Uuid
  actor      Usuario           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fecha      DateTime          @default(now())
  antes      Json
  despues    Json

  @@index([servicioId, fecha])
  @@index([platicaId, fecha])
}

model Sacerdote {
  id           String                @id @default(uuid()) @db.Uuid
  nombre       String                @db.VarChar(200)
  version      Int                   @default(1)
  asignaciones AsignacionSacerdote[]
  horarios     HorarioMisa[]
  ocurrencias  OcurrenciaMisa[]
  previstas    CelebracionMisa[]     @relation("previsto")
  oficiadas    CelebracionMisa[]     @relation("oficiante")
}

model AsignacionSacerdote {
  iglesiaId   String    @db.Uuid
  sacerdoteId String    @db.Uuid
  iglesia     Iglesia   @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  sacerdote   Sacerdote @relation(fields: [sacerdoteId], references: [id], onDelete: Restrict)

  @@id([iglesiaId, sacerdoteId])
}

enum TipoMisa {
  DIARIA
  DOMINICAL
  ESPECIAL
}

model HorarioMisa {
  id              String           @id @default(uuid()) @db.Uuid
  iglesiaId       String           @db.Uuid
  iglesia         Iglesia          @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  sacerdoteId     String           @db.Uuid
  sacerdote       Sacerdote        @relation(fields: [sacerdoteId], references: [id], onDelete: Restrict)
  diaSemana       Int
  horaLocal       String           @db.VarChar(5)
  tipo            TipoMisa
  idioma          String           @db.VarChar(100)
  duracionMinutos Int              @default(60)
  desde           String           @db.VarChar(10)
  hasta           String           @db.VarChar(10)
  zonaIana        String           @db.VarChar(100)
  activo          Boolean          @default(true)
  version         Int              @default(1)
  ocurrencias     OcurrenciaMisa[]

  @@index([iglesiaId])
}

model OcurrenciaMisa {
  id          String           @id @default(uuid()) @db.Uuid
  horarioId   String           @db.Uuid
  horario     HorarioMisa      @relation(fields: [horarioId], references: [id], onDelete: Restrict)
  iglesiaId   String           @db.Uuid
  iglesia     Iglesia          @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  sacerdoteId String           @db.Uuid
  sacerdote   Sacerdote        @relation(fields: [sacerdoteId], references: [id], onDelete: Restrict)
  fechaLocal  String           @db.VarChar(10)
  horaLocal   String           @db.VarChar(5)
  zonaIana    String           @db.VarChar(100)
  inicio      DateTime         @db.Timestamptz(3)
  fin         DateTime         @db.Timestamptz(3)
  celebracion CelebracionMisa?

  @@unique([horarioId, fechaLocal])
  @@index([sacerdoteId, inicio, fin])
  @@index([iglesiaId, fechaLocal])
}

model CelebracionMisa {
  id           String         @id @default(uuid()) @db.Uuid
  ocurrenciaId String         @unique @db.Uuid
  ocurrencia   OcurrenciaMisa @relation(fields: [ocurrenciaId], references: [id], onDelete: Restrict)
  iglesiaId    String         @db.Uuid
  iglesia      Iglesia        @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  previstoId   String         @db.Uuid
  previsto     Sacerdote      @relation("previsto", fields: [previstoId], references: [id], onDelete: Restrict)
  oficianteId  String         @db.Uuid
  oficiante    Sacerdote      @relation("oficiante", fields: [oficianteId], references: [id], onDelete: Restrict)
  fechaLocal   String         @db.VarChar(10)
  horaLocal    String         @db.VarChar(5)
  zonaIana     String         @db.VarChar(100)
  inicio       DateTime       @db.Timestamptz(3)
  fin          DateTime       @db.Timestamptz(3)
  actorId      String         @db.Uuid
  actor        Usuario        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  registradoEn DateTime       @default(now()) @db.Timestamptz(3)
  motivo       String?        @db.VarChar(500)
  diezmo       Diezmo?

  @@unique([iglesiaId, id])
  @@index([iglesiaId, fechaLocal, id])
  @@index([iglesiaId, inicio])
  @@index([oficianteId, inicio, fin])
}

model Diezmo {
  id              String             @id @default(uuid()) @db.Uuid
  iglesiaId       String             @db.Uuid
  iglesia         Iglesia            @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  celebracionId   String             @unique @db.Uuid
  celebracion     CelebracionMisa    @relation(fields: [iglesiaId, celebracionId], references: [iglesiaId, id], onDelete: Restrict)
  importeCentavos BigInt
  moneda          String             @default("MXN") @db.VarChar(3)
  version         Int                @default(1)
  correcciones    CorreccionDiezmo[]

  @@unique([iglesiaId, celebracionId])
  @@unique([iglesiaId, id])
}

model CorreccionDiezmo {
  id               String   @id @default(uuid()) @db.Uuid
  iglesiaId        String   @db.Uuid
  diezmoId         String   @db.Uuid
  diezmo           Diezmo   @relation(fields: [iglesiaId, diezmoId], references: [iglesiaId, id], onDelete: Restrict)
  actorId          String   @db.Uuid
  actor            Usuario  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  instante         DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  anteriorCentavos BigInt?
  nuevoCentavos    BigInt
  version          Int

  @@unique([diezmoId, version])
  @@index([iglesiaId, diezmoId, instante])
}

model CambioAgenda {
  id        String   @id @default(uuid()) @db.Uuid
  iglesiaId String   @db.Uuid
  recursoId String   @db.Uuid
  actorId   String   @db.Uuid
  actor     Usuario  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fecha     DateTime @default(now()) @db.Timestamptz(3)
  antes     Json
  despues   Json

  @@index([iglesiaId, recursoId, fecha])
}

enum TipoEspacio {
  CRIPTA
  NICHO
  COLUMBARIO
  OSARIO
}

enum EstadoSolicitud {
  REGISTRADA
  COTIZADA
  SIN_LUGAR
  ACEPTADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

enum ActorSolicitud {
  PERSONAL
  SOLICITANTE
  SISTEMA
}

model OfertaFuneraria {
  iglesiaId   String             @db.Uuid
  tipo        TipoEspacio
  iglesia     Iglesia            @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  activo      Boolean            @default(true)
  version     Int                @default(1)
  solicitudes SolicitudEspacio[]
  cambios     CambioEspacio[]

  @@id([iglesiaId, tipo])
}

model CambioEspacio {
  id        String          @id @default(uuid()) @db.Uuid
  iglesiaId String          @db.Uuid
  tipo      TipoEspacio
  oferta    OfertaFuneraria @relation(fields: [iglesiaId, tipo], references: [iglesiaId, tipo], onDelete: Restrict)
  actorId   String          @db.Uuid
  actor     Usuario         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  instante  DateTime        @db.Timestamptz(3)
  antes     Json
  despues   Json
  version   Int

  @@unique([iglesiaId, tipo, version])
  @@index([actorId])
}

model SolicitudEspacio {
  id             String            @id @default(uuid()) @db.Uuid
  iglesiaId      String            @db.Uuid
  iglesia        Iglesia           @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  tipo           TipoEspacio
  oferta         OfertaFuneraria   @relation(fields: [iglesiaId, tipo], references: [iglesiaId, tipo], onDelete: Restrict)
  folio          String            @unique @db.VarChar(24)
  claveHash      String            @db.VarChar(64)
  peticionId     String            @unique @db.Uuid
  nombre         String            @db.VarChar(120)
  contacto       String            @db.VarChar(200)
  estado         EstadoSolicitud   @default(REGISTRADA)
  version        Int               @default(1)
  creada         DateTime          @db.Timestamptz(3)
  precioCentavos BigInt?
  condiciones    String?           @db.VarChar(2000)
  emitida        DateTime?         @db.Timestamptz(3)
  vence          DateTime?         @db.Timestamptz(3)
  decisionEn     DateTime?         @db.Timestamptz(3)
  cambios        CambioSolicitud[]

  @@unique([id, iglesiaId])
  @@index([iglesiaId, creada, id])
  @@index([iglesiaId, tipo])
  @@index([estado, vence])
}

model CambioSolicitud {
  id          String           @id @default(uuid()) @db.Uuid
  solicitudId String           @db.Uuid
  iglesiaId   String           @db.Uuid
  solicitud   SolicitudEspacio @relation(fields: [solicitudId, iglesiaId], references: [id, iglesiaId], onDelete: Restrict)
  actor       ActorSolicitud
  actorId     String?          @db.Uuid
  personal    Usuario?         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  instante    DateTime         @db.Timestamptz(3)
  antes       Json
  despues     Json
  version     Int

  @@unique([solicitudId, version])
  @@index([actorId])
  @@index([iglesiaId])
}

model LimiteSolicitud {
  clave    String   @id @db.VarChar(64)
  cantidad Int
  vence    DateTime @db.Timestamptz(3)

  @@index([vence])
}

model CambioCierre {
 id String @id @default(uuid()) @db.Uuid
 iglesiaId String @db.Uuid
 iglesia Iglesia @relation(fields:[iglesiaId], references:[id], onDelete:Restrict)
 actorId String @db.Uuid
 actor Usuario @relation(fields:[actorId], references:[id], onDelete:Restrict)
 fecha DateTime @default(now()) @db.Timestamptz(3)
 motivo String @db.VarChar(500)
 antes DateTime?
 despues DateTime?
 version Int
 @@unique([iglesiaId,version])
}
model ConfiguracionIndice {
 id String @id
 criterioId String
 criterio CriterioPatrimonio @relation(fields:[criterioId],references:[id],onDelete:Restrict)
 version Int @default(1)
}
model CambioCriterio {
 id String @id @default(uuid()) @db.Uuid
 criterioId String
 criterio CriterioPatrimonio @relation("CriterioDestino",fields:[criterioId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor Usuario @relation(fields:[actorId],references:[id],onDelete:Restrict)
 fecha DateTime @default(now()) @db.Timestamptz(3)
 tipo String
 motivo String @db.VarChar(500)
 anterior String?
 previo CriterioPatrimonio? @relation("CriterioAnterior",fields:[anterior],references:[id],onDelete:Restrict)
 version Int?
 @@index([fecha])
}
