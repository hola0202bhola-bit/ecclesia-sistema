<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Acceso del personal · Ecclesia</title>
<style>body{font:18px system-ui;max-width:35rem;margin:auto;padding:1.5rem;color:#18352c;background:#f7f5ef}label,input,button{display:block;margin:.7rem 0}input,button{font:inherit;padding:.6rem;max-width:100%;box-sizing:border-box}a{color:#136650}.error{color:#9a2525}</style>
<main><a href="/iglesias">Consultar iglesias</a><h1>Acceso del personal</h1><% if (error) { %><p class="error" role="alert"><%= error %></p><% } %><form method="post" action="/personal/login"><label for="identificador">Identificador</label><input id="identificador" name="identificador" autocomplete="username" required maxlength="80"><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="72"><button>Entrar</button></form></main></html>
