<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Iglesias · Ecclesia</title>
<style>body{font:18px system-ui;max-width:60rem;margin:auto;padding:1rem;color:#18352c;background:#f7f5ef}a{color:#136650}input,button{font:inherit;padding:.5rem}li{margin:1rem 0}small{display:block}</style>
<main><a href="/personal/login">Acceso del personal</a><h1>Ecclesia</h1><p>Encuentra iglesias por estado</p><form><label>Clave de estado INEGI <input name="estadoClave" pattern="[0-9]{2}" maxlength="2" placeholder="21" required></label> <button>Consultar</button></form>
<% if (resultado) { %><p><%= resultado.meta.total %> iglesias encontradas · página <%= resultado.meta.page %></p><ul><% for (const iglesia of resultado.data) { %><li><a href="/iglesias/<%= iglesia.id %>"><%= iglesia.nombre %></a><small><%= iglesia.direccion %></small></li><% } %></ul><% } %>
<p><small>Demostración de Fase 0 con iglesias ficticias. Catálogo geográfico parcial para la referencia.</small></p></main></html>
