<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Iglesias · Ecclesia</title>
<style>body{font:18px system-ui;max-width:60rem;margin:auto;padding:1rem;color:#18352c;background:#f7f5ef}a{color:#136650}input,select,button{font:inherit;padding:.5rem;max-width:100%;box-sizing:border-box}label{display:block;margin:.8rem 0}li{margin:1rem 0}small{display:block}fieldset{margin:1rem 0}</style>
<main><a href="/personal/login">Acceso del personal</a><p><a href="/ranking-patrimonial">Iglesias reconocidas</a></p><h1>Ecclesia</h1><p>Encuentra iglesias por estado</p>
<form><label>Estado INEGI <select name="estadoClave" required><option value="">Seleccione</option><% for (const estado of catalogos.estados) { %><option value="<%= estado.clave %>" <%= filtros.estadoClave === estado.clave ? 'selected' : '' %>><%= estado.nombre %> (<%= estado.clave %>)</option><% } %></select></label><button>Elegir estado</button></form>
<% if (filtros.estadoClave) { %>
<form><input type="hidden" name="estadoClave" value="<%= filtros.estadoClave %>"><label>Municipio <select name="municipioClave"><option value="">Todos</option><% for (const municipio of catalogos.municipios) { %><option value="<%= municipio.codigo %>" <%= filtros.municipioClave === municipio.codigo ? 'selected' : '' %>><%= municipio.nombre %> (<%= municipio.codigo %>)</option><% } %></select></label><button>Elegir municipio</button></form>
<form><fieldset><legend>Acotar búsqueda</legend><input type="hidden" name="estadoClave" value="<%= filtros.estadoClave %>"><% if (filtros.municipioClave) { %><input type="hidden" name="municipioClave" value="<%= filtros.municipioClave %>"><label>Localidad disponible <select name="localidadClave"><option value="">Todas</option><% for (const lugar of catalogos.localidades) { %><option value="<%= lugar.localidadClave %>" <%= filtros.localidadClave === lugar.localidadClave ? 'selected' : '' %>><%= lugar.nombre %></option><% } %></select></label><% } %>
<label>Tipo <select name="tipoId"><option value="">Todos</option><% for (const tipo of catalogos.tipos) { %><option value="<%= tipo.id %>" <%= filtros.tipoId === tipo.id ? 'selected' : '' %>><%= tipo.nombre %></option><% } %></select></label>
<label>Nombre <input name="nombre" maxlength="200" value="<%= filtros.nombre ?? '' %>"></label><label>Capacidad mínima <input type="number" name="capacidadMin" min="0" max="2147483647" value="<%= filtros.capacidadMin ?? '' %>"></label><label>Capacidad máxima <input type="number" name="capacidadMax" min="0" max="2147483647" value="<%= filtros.capacidadMax ?? '' %>"></label><button>Filtrar</button></fieldset></form>
<% } %>
<% if (resultado) { %><p><%= resultado.meta.total %> iglesias encontradas · página <%= resultado.meta.page %></p><ul><% for (const iglesia of resultado.data) { %><li><a href="/iglesias/<%= iglesia.id %>"><%= iglesia.nombre %></a><small><%= iglesia.direccion %></small></li><% } %></ul>
<% if (resultado.meta.page > 1) { %><a href="<%= queryPagina(resultado.meta.page - 1) %>">Anterior</a><% } %><% if (resultado.meta.page * resultado.meta.pageSize < resultado.meta.total) { %><a href="<%= queryPagina(resultado.meta.page + 1) %>">Siguiente</a><% } %><% } %>
<p><small>Iglesias de demostración ficticias. Estados y municipios oficiales en la versión cargada; localidades parciales. Elegir otro estado o municipio inicia una nueva búsqueda.</small></p></main></html>
