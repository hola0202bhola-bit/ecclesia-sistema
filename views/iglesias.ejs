<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Iglesias · Ecclesia</title>
<link rel="stylesheet" href="/assets/ecclesia.css">
</head><body>
<%- include("partials/header") %>
<main id="contenido" class="page page-iglesias">
<div class="hero"><div><span class="eyebrow">Directorio de iglesias</span><h1>Encuentra un lugar.<br><em>Descubre su historia.</em></h1><p>Explora iglesias, conoce su patrimonio y consulta los servicios y horarios de tu comunidad.</p><a href="/ranking-patrimonial" class="button secondary">Descubrir el patrimonio <span aria-hidden="true">↗</span></a></div><div class="hero-art"><img src="/assets/iglesia.svg" alt="" width="420" height="340"></div></div>
<div class="section-heading"><h2>Explorar iglesias</h2><span class="badge">Consulta pública · Sin registro</span></div>
<div class="filters"><form class="filter-row"><label>Estado INEGI <select name="estadoClave" required><option value="">Seleccione</option><% for (const estado of catalogos.estados) { %><option value="<%= estado.clave %>" <%= filtros.estadoClave === estado.clave ? 'selected' : '' %>><%= estado.nombre %> (<%= estado.clave %>)</option><% } %></select></label><button>Elegir estado</button></form>
<% if (filtros.estadoClave) { %>
<form class="filter-row"><input type="hidden" name="estadoClave" value="<%= filtros.estadoClave %>"><label>Municipio <select name="municipioClave"><option value="">Todos</option><% for (const municipio of catalogos.municipios) { %><option value="<%= municipio.codigo %>" <%= filtros.municipioClave === municipio.codigo ? 'selected' : '' %>><%= municipio.nombre %> (<%= municipio.codigo %>)</option><% } %></select></label><button>Elegir municipio</button></form>
<details><summary>Más filtros · tipo, nombre y capacidad</summary><form><fieldset><legend>Acotar búsqueda</legend><input type="hidden" name="estadoClave" value="<%= filtros.estadoClave %>"><% if (filtros.municipioClave) { %><input type="hidden" name="municipioClave" value="<%= filtros.municipioClave %>"><label>Localidad disponible <select name="localidadClave"><option value="">Todas</option><% for (const lugar of catalogos.localidades) { %><option value="<%= lugar.localidadClave %>" <%= filtros.localidadClave === lugar.localidadClave ? 'selected' : '' %>><%= lugar.nombre %></option><% } %></select></label><% } %>
<label>Tipo <select name="tipoId"><option value="">Todos</option><% for (const tipo of catalogos.tipos) { %><option value="<%= tipo.id %>" <%= filtros.tipoId === tipo.id ? 'selected' : '' %>><%= tipo.nombre %></option><% } %></select></label>
<label>Nombre <input name="nombre" maxlength="200" value="<%= filtros.nombre ?? '' %>"></label><label>Capacidad mínima <input type="number" name="capacidadMin" min="0" max="2147483647" value="<%= filtros.capacidadMin ?? '' %>"></label><label>Capacidad máxima <input type="number" name="capacidadMax" min="0" max="2147483647" value="<%= filtros.capacidadMax ?? '' %>"></label><button>Filtrar</button></fieldset></form></details>
<% } %>
</div><% if (resultado) { %><div class="section-heading"><p class="result-meta"><strong><%= resultado.meta.total %></strong> iglesias encontradas · página <%= resultado.meta.page %></p></div>
<ul class="card-grid"><% for (const iglesia of resultado.data) { %><li class="church-card"><div class="card-art" aria-hidden="true"><img src="/assets/iglesia.svg" alt="" width="170" height="170"></div><div class="card-body"><div><span class="badge"><%= catalogos.tipos.find(t=>t.id===iglesia.tipoId)?.nombre ?? 'Iglesia' %></span></div><h3><a href="/iglesias/<%= iglesia.id %>"><%= iglesia.nombre %></a></h3><p><%= iglesia.direccion %></p><div class="card-facts"><span><%= iglesia.capacidad ?? '—' %> personas</span><span><%= iglesia.anioConstruccion ? 'Desde '+iglesia.anioConstruccion : 'Año sin dato' %></span></div><a class="card-link" href="/iglesias/<%= iglesia.id %>">Conocer la iglesia <span aria-hidden="true">↗</span></a></div></li><% } %>
<% if (!resultado.data.length) { %><li class="empty"><h2>No encontramos iglesias</h2><p>Prueba otro lugar o amplía los filtros de búsqueda.</p><a href="/iglesias" class="button secondary">Restablecer búsqueda</a></li><% } %></ul><nav class="pagination" aria-label="Páginas">
<% if (resultado.meta.page > 1) { %><a href="<%= queryPagina(resultado.meta.page - 1) %>">Anterior</a><% } %><% if (resultado.meta.page * resultado.meta.pageSize < resultado.meta.total) { %><a href="<%= queryPagina(resultado.meta.page + 1) %>">Siguiente</a><% } %></nav><% } %>
<p><small>Iglesias de demostración ficticias. Estados y municipios oficiales en la versión cargada; localidades parciales. Elegir otro estado o municipio inicia una nueva búsqueda.</small></p></main>
<%- include("partials/footer") %>
