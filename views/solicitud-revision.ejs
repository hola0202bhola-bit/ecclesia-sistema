<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Espacios y solicitudes · Ecclesia</title>
<style>body{font:18px system-ui;max-width:55rem;margin:auto;padding:1.5rem;color:#18352c;background:#f7f5ef}a{color:#136650}label{display:block;margin:.8rem 0}input,select,textarea,button{font:inherit;max-width:100%;padding:.5rem}textarea{width:95%}section,article{border-top:1px solid #becbc4;padding:1rem 0}dt{font-weight:bold}dd{margin:0 0 1rem;overflow-wrap:anywhere}button{cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style><main><a href="/personal/solicitudes/<%= iglesiaId %>">Solicitudes</a><h1>Revisar solicitud</h1><dl><dt>Folio</dt><dd><%= solicitud.folio %></dd><dt>Tipo</dt><dd><%= solicitud.tipo %></dd><dt>Estado</dt><dd><%= solicitud.estado %></dd><dt>Versión</dt><dd><%= solicitud.version %></dd></dl>
<% if (solicitud.estado === 'SIN_LUGAR') { %><p>No hay lugar para el espacio solicitado.</p><% } %>
<% if (solicitud.cotizacion) { const c=solicitud.cotizacion; %><section><h2>Cotización individual</h2><p><%= c.precio %> <%= c.moneda %></p><p><%= c.condiciones %></p><p>Emitida: <%= c.emitida %></p><p>Vence: <%= c.vence %> (UTC)</p><p>Vigencia: 15 días desde la emisión. Aceptar no registra pago ni asignación física.</p></section><% } %>
<dl><dt>Nombre</dt><dd><%= solicitud.nombre %></dd><dt>Contacto privado</dt><dd><%= solicitud.contacto %></dd></dl>
<% for (const e of errores) { %><p role="alert"><%= e %></p><% } %>
<% if (solicitud.estado === 'REGISTRADA') { %><section><h2>Informar resultado en seguimiento</h2>
<form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= valores.version ?? solicitud.version %>"><input type="hidden" name="resultado" value="COTIZAR"><label>Precio exclusivo de este servicio (MXN provisional)<input name="precio" inputmode="decimal" placeholder="0.00" required maxlength="12" value="<%= valores.precio ?? '' %>"></label><label>Condiciones <textarea name="condiciones" maxlength="2000" required><%= valores.condiciones ?? '' %></textarea></label><button>Emitir cotización por 15 días</button></form>
<form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= solicitud.version %>"><input type="hidden" name="resultado" value="SIN_LUGAR"><button>Informar falta de lugar</button></form></section><% } %>
<section><h2>Historial privado</h2><% for (const h of solicitud.historial) { %><article>Versión <%= h.version %> · <%= h.instante %> · <%= h.actor %> <%= h.actorId ?? '' %><pre><%= JSON.stringify({antes:h.antes,despues:h.despues},null,2) %></pre></article><% } %></section></main></html>
