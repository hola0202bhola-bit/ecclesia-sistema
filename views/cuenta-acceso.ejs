<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= modo==='registro' ? 'Crear cuenta' : 'Iniciar sesión' %> · Ecclesia</title><link rel="stylesheet" href="/assets/ecclesia.css"></head><body><%- include('partials/header') %><main id="contenido" class="page page-login"><div class="login-intro"><span class="eyebrow">Tu comunidad</span><h1><%= modo==='registro' ? 'Forma parte de Ecclesia.' : 'Bienvenido a Ecclesia.' %></h1><p>Consulta las iglesias, su patrimonio y la vida de tu comunidad con tu cuenta.</p></div><div class="login-card"><h2><%= modo==='registro' ? 'Crear cuenta de visitante' : 'Iniciar sesión' %></h2><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><form method="post" action="/cuenta/<%= modo %>"><input type="hidden" name="_csrf" value="<%= csrfAcceso %>"><label for="identificador">Identificador</label><input id="identificador" name="identificador" autocomplete="username" minlength="3" maxlength="80" pattern="[a-z0-9][a-z0-9._-]{2,79}" required><p class="muted">De 3 a 80 caracteres: letras minúsculas, números, punto, guion o guion bajo.</p><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="<%= modo==='registro' ? 'new-password' : 'current-password' %>" maxlength="72" required <% if(modo==='registro'){ %>minlength="15"<% } %>><% if(modo==='registro'){ %><p class="muted">Al menos 15 caracteres y un máximo de 72 bytes UTF-8.</p><% } %><button><%= modo==='registro' ? 'Crear mi cuenta' : 'Entrar' %></button></form><p><a href="/cuenta/<%= modo==='registro' ? 'login' : 'registro' %>"><%= modo==='registro' ? 'Ya tengo una cuenta' : 'Crear una cuenta' %></a></p></div></main><%- include('partials/footer') %>
