<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Estado e historial · Ecclesia</title><link rel="stylesheet" href="/assets/ecclesia.css"></head><body><%- include('partials/header') %><main id="contenido" class="page"><a href="/personal/iglesias">← Gestionar iglesias</a><h1><%= iglesia.nombre %></h1><span class="badge <%= iglesia.cerradaDesde?'closed':'' %>"><%= iglesia.cerradaDesde?'Cerrada':'Abierta' %> · Versión <%= iglesia.version %></span><dl><dt>Dirección</dt><dd><%= iglesia.direccion %></dd><dt>Contacto</dt><dd><%= iglesia.contacto??'Sin dato' %></dd><dt>Capacidad</dt><dd><%= iglesia.capacidad??'Sin dato' %></dd><dt>Construcción</dt><dd><%= iglesia.anioConstruccion??'Sin dato' %></dd><dt>Ubicación INEGI</dt><dd><%= iglesia.estadoClave %> / <%= iglesia.municipioClave %> / <%= iglesia.localidadClave %></dd></dl>
<% if(!iglesia.cerradaDesde){ %><div class="actions"><a class="button secondary" href="/personal/iglesias/<%= iglesia.id %>/editar">Editar datos</a><a href="/iglesias/<%= iglesia.id %>">Ficha pública</a></div><% } %>
<% if(errores.length){ %><section><h2>Revisar el cambio enviado</h2><% for(const e of errores){ %><p role="alert"><%= e %></p><% } %><p>Motivo enviado: <%= valores?.motivo??'' %></p><p>No se aplicó el cambio. <a href="/personal/iglesias/<%= iglesia.id %>/historial">Cargar la versión actual para comparar y volver a intentar</a>.</p></section><% } else { %><section><h2><%= iglesia.cerradaDesde?'Reabrir iglesia':'Cerrar iglesia' %></h2><p><%= iglesia.cerradaDesde?'La iglesia volverá a aparecer en las consultas públicas con sus datos conservados.':'La iglesia dejará de aparecer en consultas públicas y ranking. Sus datos e historia se conservan; la edición permanece bloqueada mientras esté cerrada.' %></p><form method="post" action="/personal/iglesias/<%= iglesia.id %>/<%= iglesia.cerradaDesde?'reabrir':'cerrar' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= iglesia.version %>"><label>Motivo del cambio<textarea name="motivo" required minlength="5" maxlength="500"></textarea></label><button><%= iglesia.cerradaDesde?'Reabrir iglesia':'Confirmar cierre' %></button></form></section><% } %><section><h2>Historial de cambios</h2><% if(!historial.length){ %><p>No hay cambios de cierre registrados.</p><% } %><% for(const h of historial){ %><article><h3><%= h.despues?'Cierre':'Reapertura' %> · versión <%= h.version %></h3><p><%= h.motivo %></p><small><%= h.fecha.toISOString() %> · Registró: <%= h.actorId %></small></article><% } %></section><p class="muted">Autoridad provisional PC04: Coordinación o administrador de su propia iglesia.</p></main><%- include('partials/footer') %>
