<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Usuarios · Ecclesia</title>
<style>body{font:18px system-ui;max-width:60rem;margin:auto;padding:1.5rem;color:#18352c;background:#f7f5ef}label,input,select{display:block;margin:.5rem 0}input,select,button{font:inherit;padding:.5rem;max-width:100%;box-sizing:border-box}a{color:#136650}li{margin:1rem 0}</style>
<main><a href="/personal">Volver al panel</a><h1>Usuarios</h1><p><%= resultado.meta.total %> cuentas · página <%= resultado.meta.page %></p><ul><% for (const usuario of resultado.data) { %><li><%= usuario.identificador %> · <%= usuario.rol %><% if (usuario.iglesiaId) { %> · <%= usuario.iglesiaId %><% } %></li><% } %></ul><% if (resultado.meta.page > 1) { %><a href="?page=<%= resultado.meta.page - 1 %>">Anterior</a><% } %> <% if (resultado.meta.page * resultado.meta.pageSize < resultado.meta.total) { %><a href="?page=<%= resultado.meta.page + 1 %>">Siguiente</a><% } %><h2>Crear cuenta</h2><form method="post" action="/personal/usuarios"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Identificador (3–80 letras minúsculas, números, punto, guion o guion bajo)<input name="identificador" required maxlength="80" autocomplete="off"></label><label>Contraseña (15 caracteres como mínimo y 72 bytes como máximo)<input name="password" type="password" required minlength="15" maxlength="72" autocomplete="new-password"></label><label>Rol<select name="rol"><option value="ADMIN_IGLESIA">Administrador de iglesia</option><option value="TESORERO">Tesorero</option><option value="COORDINACION">Coordinación</option></select></label><label>UUID de iglesia (vacío para Coordinación)<input name="iglesiaId"></label><button>Crear cuenta</button></form></main></html>
