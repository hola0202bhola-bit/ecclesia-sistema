<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Mi perfil · Ecclesia</title><link rel="stylesheet" href="/assets/ecclesia.css"></head><body><%- include('partials/header') %><main id="contenido" class="page"><span class="eyebrow">Mi cuenta</span><h1>Tu perfil</h1><div class="session-bar"><div><strong><%= usuario.identificador %></strong><br><span class="badge"><%= ({VISITANTE:'Visitante',COORDINACION:'Coordinación',ADMIN_IGLESIA:'Administración de iglesia',TESORERO:'Tesorería'})[usuario.rol] %></span></div><form method="post" action="/cuenta/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Cerrar sesión</button></form></div><% if(iglesiaAsignada){ %><section class="hero"><span class="eyebrow">Tu iglesia asignada</span><h2><%= iglesiaAsignada.nombre %></h2><a href="/iglesias/<%= iglesiaAsignada.id %>">Ver en el directorio</a></section><% } %><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><section class="login-card"><h2>Personaliza tu cuenta</h2><p class="muted">Estos datos aparecen solo en tu cuenta. Tu rol y tu iglesia se administran por separado.</p><form method="post" action="/cuenta/perfil"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= perfil.version %>"><label for="nombreVisible">Nombre visible</label><input id="nombreVisible" name="nombreVisible" maxlength="100" value="<%= perfil.nombreVisible ?? '' %>"><label for="presentacion">Presentación</label><textarea id="presentacion" name="presentacion" maxlength="500" rows="4"><%= perfil.presentacion ?? '' %></textarea><fieldset><legend>Elige tu avatar</legend><% const simbolos={templo:'⛪',campana:'🔔',paloma:'🕊',rama:'🌿'}; for(const avatar of avatares){ %><label><input type="radio" name="avatar" value="<%= avatar %>" <%= perfil.avatar===avatar ? 'checked' : '' %> required><span aria-hidden="true"><%= simbolos[avatar] %></span> <%= avatar %></label><% } %></fieldset><button>Guardar perfil</button></form></section><p><a href="/iglesias">Explorar iglesias</a></p></main><%- include('partials/footer') %>
