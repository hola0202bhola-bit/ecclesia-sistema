<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Espacios y solicitudes · Ecclesia</title>
<link rel="stylesheet" href="/assets/ecclesia.css">
</head><body>
<%- include("partials/header") %><main id="contenido" class="page page-solicitud-seguimiento"><a href="/solicitudes">Cerrar seguimiento</a><h1>Mi solicitud</h1><dl><dt>Folio</dt><dd><%= solicitud.folio %></dd><dt>Tipo</dt><dd><%= solicitud.tipo %></dd><dt>Estado</dt><dd><%= solicitud.estado %></dd><dt>Versión</dt><dd><%= solicitud.version %></dd></dl>
<% if (solicitud.estado === 'SIN_LUGAR') { %><p>No hay lugar para el espacio solicitado.</p><% } %>
<% if (solicitud.cotizacion) { const c=solicitud.cotizacion; %><section><h2>Cotización individual</h2><p><%= c.precio %> <%= c.moneda %></p><p><%= c.condiciones %></p><p>Emitida: <%= c.emitida %></p><p>Vence: <%= c.vence %> (UTC)</p><p>Vigencia: 15 días desde la emisión. Aceptar no registra pago ni asignación física.</p></section><% } %>
<% if (solicitud.estado === 'COTIZADA') { %><form method="post" action="/solicitudes/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="folio" value="<%= acceso.folio %>"><input type="hidden" name="clave" value="<%= acceso.clave %>"><input type="hidden" name="version" value="<%= solicitud.version %>"><button name="accion" value="ACEPTAR">Aceptar cotización</button> <button name="accion" value="RECHAZAR">Rechazar cotización</button></form><% } %>
<% if (!['ACEPTADA','CANCELADA'].includes(solicitud.estado)) { %><form method="post" action="/solicitudes/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="folio" value="<%= acceso.folio %>"><input type="hidden" name="clave" value="<%= acceso.clave %>"><input type="hidden" name="version" value="<%= solicitud.version %>"><button name="accion" value="CANCELAR">Cancelar solicitud</button></form><% } %></main>
<%- include("partials/footer") %>
