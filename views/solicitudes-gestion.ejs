<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Espacios y solicitudes · Ecclesia</title>
<style>body{font:18px system-ui;max-width:55rem;margin:auto;padding:1.5rem;color:#18352c;background:#f7f5ef}a{color:#136650}label{display:block;margin:.8rem 0}input,select,textarea,button{font:inherit;max-width:100%;padding:.5rem}textarea{width:95%}section,article{border-top:1px solid #becbc4;padding:1rem 0}dt{font-weight:bold}dd{margin:0 0 1rem;overflow-wrap:anywhere}button{cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style><main><a href="/personal">Personal</a><h1>Espacios y solicitudes de mi iglesia</h1><section><h2>Tipos ofertados</h2><p>Activar o retirar oferta no administra unidades físicas ni altera solicitudes existentes.</p>
<% for (const e of espacios) { %><form method="post" action="/personal/solicitudes/<%= iglesiaId %>/espacios/<%= e.tipo %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= e.version %>"><input type="hidden" name="activo" value="<%= !e.activo %>"><p><strong><%= e.tipo %></strong> · <%= e.activo ? 'Ofertado' : 'No ofertado' %> · versión <%= e.version %> <button><%= e.activo ? 'Retirar oferta' : 'Ofertar' %></button></p></form><% } %></section>
<section><h2>Solicitudes privadas</h2><p>Total: <%= lista.total %> · Página <%= lista.pagina %></p>
<% for (const s of lista.data) { %><article><a href="/personal/solicitudes/<%= iglesiaId %>/<%= s.id %>"><%= s.folio %></a> · <%= s.tipo %> · <%= s.estado %></article><% } %>
<% if (lista.pagina > 1) { %><a href="?pagina=<%= lista.pagina - 1 %>">Anterior</a><% } %>
<% if (lista.pagina * 25 < lista.total) { %><a href="?pagina=<%= lista.pagina + 1 %>">Siguiente</a><% } %></section></main></html>
