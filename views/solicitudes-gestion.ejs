<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Espacios y solicitudes · Ecclesia</title>
<link rel="stylesheet" href="/assets/ecclesia.css">
</head><body>
<%- include("partials/header") %><main id="contenido" class="page page-solicitudes-gestion"><a href="/personal">Personal</a><h1>Espacios y solicitudes de mi iglesia</h1><section><h2>Tipos ofertados</h2><p>Activar o retirar oferta no administra unidades físicas ni altera solicitudes existentes.</p>
<% for (const e of espacios) { %><form method="post" action="/personal/solicitudes/<%= iglesiaId %>/espacios/<%= e.tipo %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= e.version %>"><input type="hidden" name="activo" value="<%= !e.activo %>"><p><strong><%= e.tipo %></strong> · <%= e.activo ? 'Ofertado' : 'No ofertado' %> · versión <%= e.version %> <button><%= e.activo ? 'Retirar oferta' : 'Ofertar' %></button></p></form><% } %></section>
<section><h2>Solicitudes privadas</h2><p>Total: <%= lista.total %> · Página <%= lista.pagina %></p>
<% for (const s of lista.data) { %><article><a href="/personal/solicitudes/<%= iglesiaId %>/<%= s.id %>"><%= s.folio %></a> · <%= s.tipo %> · <%= s.estado %></article><% } %>
<% if (lista.pagina > 1) { %><a href="?pagina=<%= lista.pagina - 1 %>">Anterior</a><% } %>
<% if (lista.pagina * 25 < lista.total) { %><a href="?pagina=<%= lista.pagina + 1 %>">Siguiente</a><% } %></section></main>
<%- include("partials/footer") %>
