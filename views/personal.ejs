<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Personal · Ecclesia</title>
<style>body{font:18px system-ui;max-width:55rem;margin:auto;padding:1.5rem;color:#18352c;background:#f7f5ef}a{color:#136650}button{font:inherit;padding:.6rem}</style>
<main><a href="/iglesias">Consultar iglesias</a><h1>Panel del personal</h1><p>Sesión de <strong><%= usuario.identificador %></strong></p><p>Rol: <%= usuario.rol %></p><% if (usuario.iglesiaId) { %><p>Iglesia: <%= usuario.iglesiaId %></p><a href="/iglesias/<%= usuario.iglesiaId %>">Ver mi iglesia</a><% } %><% if (usuario.rol === 'COORDINACION') { %><p><a href="/personal/usuarios">Gestionar usuarios</a></p><% } %><% if (usuario.rol === 'COORDINACION' || usuario.rol === 'ADMIN_IGLESIA') { %><p><a href="/personal/iglesias">Gestionar iglesias</a></p><% } %><% if (usuario.rol === 'ADMIN_IGLESIA' && usuario.iglesiaId) { %><p><a href="/personal/patrimonio/<%= usuario.iglesiaId %>">Gestionar patrimonio</a></p><p><a href="/personal/oferta/<%= usuario.iglesiaId %>/servicios">Gestionar servicios</a></p><p><a href="/personal/oferta/<%= usuario.iglesiaId %>/platicas">Gestionar pláticas</a></p><p><a href="/personal/agenda/<%= usuario.iglesiaId %>">Gestionar sacerdotes y misas</a></p><% } %><% if (usuario.iglesiaId && ['ADMIN_IGLESIA','TESORERO'].includes(usuario.rol)) { %><p><a href="/personal/diezmos/<%= usuario.iglesiaId %>">Diezmos y reportes</a></p><% } %><form method="post" action="/personal/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Cerrar sesión</button></form></main></html>
