<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Personal · Ecclesia</title><link rel="stylesheet" href="/assets/ecclesia.css"></head><body><%- include("partials/header") %><main id="contenido" class="page page-personal">
<span class="eyebrow">Área del personal</span><h1>Panel del personal</h1><div class="session-bar"><div>Sesión de <strong><%= usuario.identificador %></strong><br><span class="badge"><%= ({COORDINACION:'Coordinación',ADMIN_IGLESIA:'Administración de iglesia',TESORERO:'Tesorería'})[usuario.rol] %></span></div><form method="post" action="/personal/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Cerrar sesión</button></form></div>
<h2>Tu espacio de trabajo</h2><p class="muted">Selecciona el módulo que quieres consultar o gestionar.</p><div class="dashboard-grid">
<% const enlaces=[]; if(usuario.rol==='COORDINACION') enlaces.push(['/personal/usuarios','Gestionar usuarios','Cuentas y acceso del personal.'],['/personal/criterios','Criterios del índice','Configurar versiones y activar criterios.']); if(['COORDINACION','ADMIN_IGLESIA'].includes(usuario.rol)) enlaces.push(['/personal/iglesias','Gestionar iglesias','Datos, cierre, reapertura e historial.']); if(usuario.rol==='ADMIN_IGLESIA'&&usuario.iglesiaId) enlaces.push(['/personal/patrimonio/'+usuario.iglesiaId,'Gestionar patrimonio','Piezas, conservación e índice patrimonial.'],['/personal/oferta/'+usuario.iglesiaId+'/servicios','Gestionar servicios','Oferta, requisitos, costos y horarios.'],['/personal/oferta/'+usuario.iglesiaId+'/platicas','Gestionar pláticas','Sesiones, lugar e información de preparación.'],['/personal/agenda/'+usuario.iglesiaId,'Gestionar sacerdotes y misas','Asignaciones, horarios y celebraciones.'],['/personal/solicitudes/'+usuario.iglesiaId,'Gestionar espacios y solicitudes','Oferta funeraria y atención de solicitudes.']); if(usuario.iglesiaId&&['ADMIN_IGLESIA','TESORERO'].includes(usuario.rol)) enlaces.push(['/personal/diezmos/'+usuario.iglesiaId,'Diezmos y reportes','Capturas y consulta de aportaciones.']); for(const [i,e] of enlaces.entries()) { %><a class="dashboard-link" href="<%= e[0] %>"><span class="number">MÓDULO <%= String(i+1).padStart(2,'0') %></span><strong><%= e[1] %></strong><small><%= e[2] %></small><span class="arrow" aria-hidden="true">↗</span></a><% } %></div><% if(usuario.iglesiaId){ %><p><a href="/iglesias/<%= usuario.iglesiaId %>">Ver mi iglesia en el directorio público</a></p><% } %></main><%- include("partials/footer") %>
