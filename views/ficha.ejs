<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= iglesia.nombre %> · Ecclesia</title>
<link rel="stylesheet" href="/assets/ecclesia.css">
</head><body>
<%- include("partials/header") %>
<main id="contenido" class="page page-ficha"><a href="/iglesias?estadoClave=<%= iglesia.estadoClave %>">Volver a iglesias</a><h1><%= iglesia.nombre %></h1>
<dl><dt>Dirección</dt><dd><%= iglesia.direccion %></dd><dt>Ubicación INEGI</dt><dd><%= iglesia.estadoClave %> / <%= iglesia.municipioClave %> / <%= iglesia.localidadClave %></dd><dt>Capacidad</dt><dd><%= iglesia.capacidad ?? 'Sin dato' %></dd><dt>Año de construcción</dt><dd><%= iglesia.anioConstruccion ?? 'Sin dato' %></dd><dt>Contacto</dt><dd><%= iglesia.contacto ?? 'Sin dato' %></dd></dl>
<% if (typeof resumen !== 'undefined') { const r=resumen; const dias=['','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo']; const hs=(horarios)=>horarios.map(h=>dias[h.diaSemana]+' '+h.horaLocal).join(', '); %>
<p><strong><%= r.ubicacion.tipos.find(t=>t.id===iglesia.tipoId)?.nombre ?? 'Tipo sin dato' %></strong> · <%= r.ubicacion.localidades.find(l=>l.clave===iglesia.estadoClave+iglesia.municipioClave+iglesia.localidadClave)?.nombre ?? 'Localidad sin nombre' %>, <%= r.ubicacion.municipios.find(m=>m.codigo===iglesia.municipioClave)?.nombre ?? '' %>, <%= r.ubicacion.estados.find(e=>e.clave===iglesia.estadoClave)?.nombre ?? '' %></p>
<section aria-labelledby="patrimonio"><h2 id="patrimonio">Patrimonio e índice</h2><p>Índice <strong><%= r.piezas.calculo.indice %></strong> · <%= r.piezas.calculo.distincion ?? 'Sin distinción' %></p><p><%= r.piezas.meta.total %> objetos vigentes. Se muestran hasta cinco.</p><ul><% if(!r.piezas.data.length){ %><li>Aún no hay piezas publicadas.</li><% } %><% for(const o of r.piezas.data) { %><li><%= o.descripcion %> · <%= o.anioExacto ?? ('Siglo '+o.siglo) %></li><% } %></ul><a href="/iglesias/<%= iglesia.id %>/patrimonio">Consultar patrimonio e índice completo</a></section>
<section aria-labelledby="servicios"><h2 id="servicios">Servicios</h2><p><%= r.servicios.meta.total %> servicios. Se muestran hasta cinco; horarios locales.</p><ul><% if(!r.servicios.data.length){ %><li>Aún no hay servicios publicados.</li><% } %><% for(const s of r.servicios.data) { %><li><strong><%= s.nombre %></strong> · <%= s.modalidad==='FIJO' ? s.importe+' '+s.moneda : s.modalidad==='GRATUITO' ? 'Gratuito' : 'Donativo voluntario' %><small><%= hs(s.horarios) %></small></li><% } %></ul><a href="/iglesias/<%= iglesia.id %>/servicios">Consultar servicios y requisitos completos</a></section>
<section aria-labelledby="platicas"><h2 id="platicas">Pláticas</h2><p><%= r.platicas.meta.total %> pláticas. Se muestran hasta cinco; horarios locales.</p><ul><% if(!r.platicas.data.length){ %><li>Aún no hay pláticas publicadas.</li><% } %><% for(const p of r.platicas.data) { %><li><%= r.tiposPlatica.find(t=>t.id===p.tipoId)?.nombre ?? 'Plática' %> · <%= p.importe %> <%= p.moneda %><small><%= p.sesiones %> sesiones · <%= p.lugar %> · <%= hs(p.horarios) %></small></li><% } %></ul><a href="/iglesias/<%= iglesia.id %>/platicas">Consultar pláticas completas</a></section>
<section aria-labelledby="misas"><h2 id="misas">Próximas misas y sacerdotes</h2><p><% if(r.desde) { %>Siete días desde <%= r.desde %> · <%= iglesia.zonaIana %>. <%= r.totalMisas %> misas; se muestran hasta siete.<% } else { %>Zona horaria sin configurar; consulte los horarios de la iglesia.<% } %></p><ul><% if(!r.misas.length){ %><li>No hay próximas misas en esta semana.</li><% } %><% for(const m of r.misas) { %><li><%= m.fechaLocal %> <%= m.horaLocal %> · <%= m.sacerdote.nombre %> · <%= m.horario.tipo %> · <%= m.horario.idioma %></li><% } %></ul><a href="/iglesias/<%= iglesia.id %>/misas">Consultar misas y otras semanas</a></section>
<section aria-labelledby="espacios"><h2 id="espacios">Espacios funerarios</h2><p>Tipos ofertados; la disponibilidad se revisa al solicitar.</p><ul><% if(!r.espacios.length){ %><li>No hay tipos de espacio ofertados.</li><% } %><% for(const e of r.espacios) { %><li><%= e.tipo %></li><% } %></ul><a href="/iglesias/<%= iglesia.id %>/espacios">Consultar espacios funerarios / solicitar</a> · <a href="/solicitudes">Seguimiento de solicitud</a></section>
<% } else { %><nav><a href="/iglesias/<%= iglesia.id %>/patrimonio">Consultar patrimonio e índice</a> · <a href="/iglesias/<%= iglesia.id %>/servicios">Consultar servicios</a> · <a href="/iglesias/<%= iglesia.id %>/platicas">Consultar pláticas</a> · <a href="/iglesias/<%= iglesia.id %>/misas">Consultar misas</a> · <a href="/iglesias/<%= iglesia.id %>/espacios">Consultar espacios funerarios / solicitar</a></nav><% } %>
</main>
<%- include("partials/footer") %>
