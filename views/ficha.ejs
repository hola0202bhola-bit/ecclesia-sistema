<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= iglesia.nombre %> · Ecclesia</title>
<style>body{font:18px system-ui;max-width:50rem;margin:auto;padding:1rem;color:#18352c;background:#f7f5ef}dt{font-weight:bold;margin-top:1rem}dd{margin-left:0}a{color:#136650}</style>
<main><a href="/iglesias?estadoClave=<%= iglesia.estadoClave %>">Volver a iglesias</a><h1><%= iglesia.nombre %></h1><dl><dt>Dirección</dt><dd><%= iglesia.direccion %></dd><dt>Ubicación INEGI</dt><dd><%= iglesia.estadoClave %> / <%= iglesia.municipioClave %> / <%= iglesia.localidadClave %></dd><dt>Capacidad</dt><dd><%= iglesia.capacidad ?? 'Sin dato' %></dd><dt>Año de construcción</dt><dd><%= iglesia.anioConstruccion ?? 'Sin dato' %></dd><dt>Contacto</dt><dd><%= iglesia.contacto ?? 'Sin dato' %></dd></dl><p><a href="/iglesias/<%= iglesia.id %>/patrimonio">Consultar patrimonio e índice</a></p><nav><p><a href="/iglesias/<%= iglesia.id %>/servicios">Consultar servicios</a></p><p><a href="/iglesias/<%= iglesia.id %>/platicas">Consultar pláticas</a></p><p><a href="/iglesias/<%= iglesia.id %>/misas">Consultar misas</a></p><p><a href="/iglesias/<%= iglesia.id %>/espacios">Consultar espacios funerarios / solicitar</a></p><p><a href="/solicitudes">Seguimiento de solicitud</a></p></nav></main></html>
