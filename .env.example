# Configurar localmente. Nunca enviar secretos al chat ni al repositorio.
DATABASE_URL=postgresql://USUARIO:CLAVE@127.0.0.1:5432/ecclesia_referencia
JWT_SECRET=
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Local: all. En producción seleccionar api, front o admin.
APP_SURFACE=all
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
# Para modos separados: orígenes exactos de los otros servicios.
# FRONT_ORIGIN=
# ADMIN_ORIGIN=
# Render: no copiar HOST/APP_ORIGIN locales; usa render.yaml y su URL propia.
